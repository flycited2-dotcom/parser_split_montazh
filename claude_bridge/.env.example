# Конфиг моста Claude <-> Telegram.
#   cp .env.example .env   и заполни значения.
# .env в .gitignore — реальные токены в репозиторий НЕ коммитить
# (Telegram сканирует публичный GitHub и отзывает засвеченные токены).

# ─── Обязательно ─────────────────────────────────────────

# Токен НОВОГО бота от @BotFather (не переиспользуй бота парсера —
# у них конфликтуют getUpdates). Например: bot "Claude Помощник".
BRIDGE_BOT_TOKEN=

# Твой личный Telegram user ID (узнать: напиши @userinfobot).
# Несколько ID — через запятую. БЕЗ этого мост не стартует:
# кто пишет боту — тот управляет твоей машиной.
BRIDGE_ALLOWED_USER_IDS=

# ─── Опционально ─────────────────────────────────────────

# Директория по умолчанию, где Claude работает (repo/проект).
BRIDGE_DEFAULT_DIR=~

# Именованные проекты для быстрого переключения: /project hvac
# Формат: имя=/путь;имя2=/путь2
BRIDGE_PROJECTS=hvac=/home/hvac_parser

# Путь к бинарнику claude, если он не в PATH сервиса.
# Узнать: which claude   (часто ~/.local/bin/claude или /usr/local/bin/claude)
CLAUDE_BIN=

# Режим прав Claude Code:
#   acceptEdits       — правит файлы сам, команды по своим правилам (дефолт)
#   bypassPermissions — полная автономия, ничего не спрашивает (мощно, но рискованно)
#   plan              — только план, ничего не делает
BRIDGE_PERMISSION_MODE=acceptEdits

# Максимальное время одной задачи, секунд (дефолт 3600 = 1 час).
BRIDGE_TASK_TIMEOUT=3600

# Дополнительные аргументы claude, например: --model claude-sonnet-5
BRIDGE_CLAUDE_ARGS=
