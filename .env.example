# Скопируйте в .env и заполните значения
#   cp .env.example .env
#
# ВНИМАНИЕ: .env содержит секреты — он в .gitignore. НЕ кладите реальные
# токены/ID в .env.example, иначе они попадут в публичный репозиторий, и
# Telegram/VK/Google автоматически их отзовут.

# ─── VK API ──────────────────────────────────────────────
# user access_token с правами groups (получить на vk.com/dev).
# На сервере setup.sh подтянет автоматически из /home/crimea_parser/.env.
VK_TOKEN=

# ─── Telegram уведомления и бот управления ───────────────
# Токен бота от @BotFather. Бот используется и для notify, и для long-poll
# меню в группе. При утечке в публичный репо Telegram отзовёт автоматически.
TG_BOT_TOKEN=

# ID группы/чата, куда идут отчёты и где работает бот управления.
# Формат: отрицательное число для супергрупп (-100xxxxxxxxxx).
TG_CHAT_ID=

# ─── Google Drive ────────────────────────────────────────
# ID папки в Drive (последняя часть URL https://drive.google.com/drive/folders/<ID>).
GDRIVE_FOLDER_ID=

# Путь к token.json (генерируется через setup_gdrive_auth.py).
# Можно делить с парсером отелей: /home/crimea_parser/token.json.
GDRIVE_TOKEN=/home/crimea_parser/token.json

# ─── Браузер ─────────────────────────────────────────────
# 1 = headless (без GUI, для сервера); 0 = с окном (для отладки локально).
HEADLESS=1

# ─── Отладка ─────────────────────────────────────────────
# Запустить только указанные источники через запятую: osm, vk, yandex, avito, search.
# Пусто = все.
ONLY_SOURCES=

# 1 = пропустить Email Finder (ускоряет тест-прогон).
SKIP_ENRICHMENT=0
