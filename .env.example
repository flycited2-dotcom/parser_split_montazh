# Скопируйте в .env и заполните нужные значения
# cp .env.example .env

# ─── VK API ──────────────────────────────────────────────
# user access_token с правами groups (получить на vk.com/dev)
VK_TOKEN=

# ─── Telegram уведомления ────────────────────────────────
# Токен бота (от @BotFather)
TG_BOT_TOKEN=
# ID чата/канала куда слать отчёты (например: -1001234567890)
TG_CHAT_ID=

# ─── Google Drive ────────────────────────────────────────
# ID папки в Drive (последняя часть URL: /drive/folders/<ID>)
GDRIVE_FOLDER_ID=1h5i0uPkmScGRKufGXEc1qu0pWyWioqax
# Путь к токену авторизации (сгенерировать через setup_gdrive_auth.py)
GDRIVE_TOKEN=/home/hvac_parser/token.json

# ─── Браузер ─────────────────────────────────────────────
# 1 = headless (без GUI, для сервера), 0 = с окном (для отладки)
HEADLESS=1

# ─── Отладка ─────────────────────────────────────────────
# Запустить только указанные источники (через запятую):
# osm, vk, yandex, avito, search
# Пусто = запустить все
ONLY_SOURCES=

# Пропустить Email Finder (ускоряет тест-прогон)
SKIP_ENRICHMENT=0
